name: Release tarball

on:
  push:
    tags:
      - "*"   # 推送任意tag就触发，比如 1.0 或 2.1

jobs:
  release:
    runs-on: ubuntu-latest
    permissions:
      contents: write  # 允许创建Release/上传附件
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Create tar.gz (source)
        run: |
          set -eux
          PROJECT_NAME="TrollStore-fork"  # 你可以改成自己的名字
          VERSION="${GITHUB_REF_NAME}"

          mkdir -p out
          # 打包当前仓库内容，排除 .git 和 GitHub 工作流等
          tar --exclude=.git --exclude=.github --exclude=.gitignore \
              -czf "out/${PROJECT_NAME}-${VERSION}.tar.gz" .

      - name: Create GitHub Release and upload asset
        uses: softprops/action-gh-release@v2
        with:
          files: out/*.tar.gz
